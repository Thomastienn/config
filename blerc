# Source the centralized theme configuration
if [[ -f "$HOME/thomas_config/theme.sh" ]]; then
  source "$HOME/thomas_config/theme.sh"
fi

# ================================================================
# BLE.SH THEME CONFIGURATION (COZY MINT)
# ================================================================
# Professional dark theme with mint and lavender accents
# Easy on the eyes, high readability
# ================================================================

# General text and defaults
ble-face syntax_default="fg=${THEME_TEXT}"       # Cream
ble-face disabled="fg=${THEME_MUTED}"             # Muted text

# Command structure
ble-face syntax_command="fg=${THEME_PRIMARY},bold"   # Mint
ble-face command_keyword="fg=${THEME_SECONDARY},bold" # Lavender
ble-face command_builtin="fg=${THEME_PRIMARY}"       # Mint
ble-face command_builtin_dot="fg=${THEME_SECONDARY}"  # Lavender
ble-face command_alias="fg=${THEME_PRIMARY}"         # Mint
ble-face command_function="fg=${THEME_SECONDARY}"     # Lavender
ble-face syntax_function_name="fg=${THEME_SECONDARY}"
ble-face argument_option="fg=${THEME_PRIMARY}"       # Mint

# Variables
ble-face syntax_varname="fg=${THEME_SECONDARY}"       # Lavender
ble-face varname_array="fg=${THEME_SECONDARY},bold"
ble-face varname_hash="fg=${THEME_SECONDARY},bold"
ble-face varname_expr="fg=${THEME_PRIMARY},bold"     # Mint
ble-face varname_transform="fg=${THEME_PRIMARY}"
ble-face varname_export="fg=${THEME_PRIMARY},bold"   # Mint
ble-face varname_readonly="fg=${THEME_PRIMARY}"
ble-face varname_number="fg=${THEME_WARNING}"       # Amber
ble-face varname_empty="fg=${THEME_MUTED}"
ble-face varname_unset="fg=${THEME_MUTED}"
ble-face varname_new="fg=${THEME_SECONDARY}"          # Lavender

# Syntax elements
ble-face syntax_delimiter="fg=${THEME_PRIMARY}"      # Mint
ble-face syntax_brace="fg=${THEME_PRIMARY},bold"     # Mint
ble-face syntax_quoted="fg=${THEME_TEXT}"        # Cream (override green default)
ble-face syntax_quotation="fg=${THEME_PRIMARY}"      # Mint (override green default)
ble-face syntax_escape="fg=${THEME_WARNING}"        # Amber
ble-face syntax_expr="fg=${THEME_SECONDARY}"          # Lavender
ble-face syntax_glob="fg=${THEME_PRIMARY},bold"      # Mint
ble-face syntax_tilde="fg=${THEME_SECONDARY}"         # Lavender
ble-face syntax_param_expansion="fg=${THEME_PRIMARY}"
ble-face syntax_history_expansion="fg=${THEME_BACKGROUND},bg=${THEME_PRIMARY}"  # Black on mint
ble-face syntax_document="fg=${THEME_TEXT}"
ble-face syntax_document_begin="fg=${THEME_PRIMARY},bold"
ble-face syntax_comment="fg=${THEME_MUTED}"       # Muted text

# Commands (override green defaults)
ble-face command_file="fg=${THEME_SECONDARY}"         # Lavender (override green default)
ble-face command_directory="fg=${THEME_PRIMARY},underline"  # Mint
ble-face command_suffix="fg=${THEME_TEXT},bg=${THEME_SELECTION}"        # Light on gunmetal (override green bg)
ble-face command_suffix_new="fg=${THEME_TEXT},bg=${THEME_ERROR}"   # Light on red

# Errors and warnings
ble-face syntax_error="fg=${THEME_BACKGROUND},bg=${THEME_ERROR}"        # Rose
ble-face argument_error="fg=${THEME_BACKGROUND},bg=${THEME_ERROR}"
ble-face filename_warning="fg=${THEME_WARNING},underline" # Amber
ble-face filename_orphan="fg=${THEME_MUTED},underline"
ble-face command_jobs="fg=${THEME_PRIMARY},bold"

# File and directory names
ble-face filename_directory="fg=${THEME_PRIMARY},bold"       # Mint
ble-face filename_directory_sticky="fg=${THEME_BACKGROUND},bg=${THEME_PRIMARY}"
ble-face filename_executable="fg=${THEME_SECONDARY}"          # Lavender
ble-face filename_link="fg=${THEME_PRIMARY},underline"       # Mint
ble-face filename_other="fg=${THEME_TEXT}"               # Cream
ble-face filename_url="fg=${THEME_PRIMARY},underline"        # Mint

# Highlighting and UI
ble-face region="bg=${THEME_SELECTION},fg=${THEME_TEXT}"                # Lavender selection bg, light text
ble-face region_insert="bg=${THEME_PRIMARY},fg=${THEME_TEXT}"         # Mint bg
ble-face region_match="bg=${THEME_SELECTION},fg=${THEME_TEXT}"          # Lavender selection bg
ble-face region_target="bg=${THEME_PRIMARY},fg=${THEME_BACKGROUND}"          # Mint bg
ble-face overwrite_mode="fg=${THEME_BACKGROUND},bg=${THEME_WARNING}"        # Amber
ble-face vbell="bg=${THEME_PRIMARY}"                        # Mint
ble-face vbell_erase="bg=${THEME_MUTED}"
ble-face vbell_flash="fg=${THEME_PRIMARY},reverse"          # Mint (override green default)
ble-face prompt_status_line="fg=${THEME_TEXT},bg=${THEME_SELECTION}"    # Light on gunmetal

# Additional file/directory faces (override green defaults)
ble-face filename_pipe="fg=${THEME_PRIMARY},underline,bg=${THEME_SURFACE}"      # Mint (override lime default)
ble-face filename_socket="fg=${THEME_SECONDARY},underline,bg=${THEME_SURFACE}"   # Lavender
ble-face filename_character="fg=${THEME_TEXT},underline,bg=${THEME_SURFACE}"
ble-face filename_block="fg=${THEME_WARNING},underline,bg=${THEME_SURFACE}"    # Amber
ble-face filename_setuid="fg=${THEME_BACKGROUND},underline,bg=${THEME_WARNING}"    # Black on copper
ble-face filename_setgid="fg=${THEME_BACKGROUND},underline,bg=${THEME_SECONDARY}"    # Black on pale steel
ble-face filename_ls_colors="underline"

# Autocomplete menu
ble-face auto_complete="bg=${THEME_SURFACE},fg=${THEME_MUTED}"             # Dark bg, dim suggestion
ble-face menu_filter_input="bg=${THEME_SELECTION},fg=${THEME_TEXT},bold"     # Lavender selection bg, light text
ble-face menu_filter_fixed="fg=${THEME_PRIMARY},bold"            # Mint
ble-face menu_complete_match="fg=${THEME_PRIMARY},bold"          # Mint for matched text
ble-face menu_complete_selected="bg=${THEME_PRIMARY},fg=${THEME_BACKGROUND},bold" # Mint bg, dark text
ble-face cmdinfo_cd_cdpath="fg=${THEME_PRIMARY},bg=${THEME_SELECTION}"           # Mint on gunmetal

# Blank line between commands; quiet rose exit mark
bleopt prompt_ruler=empty-line
bleopt exec_errexit_mark="${THEME_COLOR5@E}✘ %d${THEME_RESET@E}"

# Vi mode shown by cursor shape (bar insert, block normal) instead of a "-- INSERT --" line.
# The vi keymap loads lazily, so its options only exist after load.
blehook/eval-after-load keymap_vi 'bleopt keymap_vi_mode_show=; ble-bind -m vi_imap --cursor 5; ble-bind -m vi_nmap --cursor 2'

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd
ble-import -d integration/fzf-key-bindings
