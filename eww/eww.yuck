;; Quick-settings flyout, opened from the Polybar status island (qs.sh toggle).
;; Polls only while the flyout is open; every action reuses the bar's scripts.

(defvar qs_cmd "$HOME/thomas_config/eww/scripts/qs.sh")
(defvar desktop_cmd "/usr/bin/python3 $HOME/thomas_config/scripts/desktop-controls.py")
(defvar qs_page 0)
(defvar afk_cmd "/usr/bin/python3 $HOME/thomas_config/scripts/afk.py")
(defpoll desktop :interval "1s"
  :initial '{"outputs":[],"inputs":[],"audio_available":false,"audio_error":"Loading audio…","afk":false,"dnd":false,"dnd_available":false,"apps":[],"apps_available":false,"apps_editable":false,"apps_error":"Loading apps…","allowed_count":0,"notifications":[],"history_available":false}'
  "/usr/bin/python3 $HOME/thomas_config/scripts/desktop-controls.py status")

(defpoll qs :interval "1s"
  :initial '{"vol":0,"vol_muted":false,"mic_muted":false,"bright":0,"kbd":"--","hz":0,"wifi":"","gpu":"","media":"","playing":false,"battery":{"enabled":false,"available":false,"detail":"Loading…"}}'
  "$HOME/thomas_config/eww/scripts/qs.sh status")

(defpoll updates :interval "1800s" :initial "…"
  "$HOME/thomas_config/polybar/shapes/scripts/updates.sh")

(defwidget tile [icon text detail on cmd]
  (button :timeout "10s" :class "tile ${on ? 'on' : ''}" :onclick cmd
    (box :space-evenly false :spacing 14
      (label :class "tile-icon" :text icon)
      (box :orientation "v" :space-evenly false :spacing 4
        (label :class "tile-text" :xalign 0 :text text)
        (label :class "tile-detail" :xalign 0 :limit-width 20 :tooltip detail :text detail)))))

(defwidget slider-row [icon text value cmd ?icon-cmd]
  (box :class "slider-row" :orientation "v" :space-evenly false :spacing 10
    (box :space-evenly false
      (label :hexpand true :xalign 0 :text text)
      (label :class "slider-value" :text "${value}%"))
    (box :space-evenly false :spacing 16
      (button :class "slider-icon" :tooltip text :onclick {icon-cmd ?: ""} icon)
      (scale :class "slider" :hexpand true :min 0 :max 101 :value value :onchange cmd))))

(defwidget audio-devices []
  (box :orientation "v" :space-evenly false :spacing 24
    (label :visible {!desktop.audio_available} :class "muted" :xalign 0 :wrap true :width 480 :text {desktop.audio_error})
    (box :visible {desktop.audio_available} :orientation "v" :space-evenly false :spacing 12
      (label :class "section-label" :xalign 0 :text "Sound output")
      (label :visible {arraylength(desktop.outputs) == 0} :class "muted" :xalign 0 :text "No output connected")
      (box :orientation "v" :space-evenly false :spacing 10
        (for device in {desktop.outputs}
          (button :timeout "10s" :class "device ${device.selected ? 'selected' : ''}"
                  :tooltip {device.name} :onclick "${desktop_cmd} audio output ${device.id}"
            (label :xalign 0 :wrap true :wrap-mode "wordchar" :width 456 :text "${device.selected ? '● ' : '○ '}${device.name}")))))
    (box :visible {desktop.audio_available} :orientation "v" :space-evenly false :spacing 12
      (label :class "section-label" :xalign 0 :text "Microphone")
      (label :visible {arraylength(desktop.inputs) == 0} :class "muted" :xalign 0 :text "No microphone connected")
      (box :orientation "v" :space-evenly false :spacing 10
        (for device in {desktop.inputs}
          (button :timeout "10s" :class "device ${device.selected ? 'selected' : ''}"
                  :tooltip {device.name} :onclick "${desktop_cmd} audio input ${device.id}"
            (label :xalign 0 :wrap true :wrap-mode "wordchar" :width 456 :text "${device.selected ? '● ' : '○ '}${device.name}")))))))

(defwidget notification-history []
  (box :orientation "v" :space-evenly false :spacing 20
    (label :class "section-label" :xalign 0 :text "Notification history")
    (label :visible {!desktop.history_available} :class "muted" :xalign 0 :text "Notification history unavailable")
    (label :visible {desktop.history_available && arraylength(desktop.notifications) == 0}
           :class "muted" :xalign 0 :text "No past notifications")
    (box :orientation "v" :space-evenly false :spacing 24
      (for notice in {desktop.notifications}
        (box :class "notice" :orientation "v" :space-evenly false :spacing 8
          (label :class "section-label" :xalign 0 :wrap true :wrap-mode "wordchar" :width 480 :text {notice.summary})
          (label :visible {notice.body != ""} :xalign 0 :wrap true :wrap-mode "wordchar" :width 480 :text {notice.body}))))
    (button :visible {arraylength(desktop.notifications) > 0} :class "compact-btn"
            :onclick "${desktop_cmd} clear-history" "Clear history")))

(defwidget settings-tab [text index]
  (button :class "settings-tab ${qs_page == index ? 'selected' : ''}" :onclick "${qs_cmd} page ${index}" text))

(defwidget allowed-apps []
  (box :orientation "v" :space-evenly false :spacing 20
    (box :space-evenly false :spacing 12
      (button :class "compact-btn" :tooltip "Back to Controls" :onclick "${qs_cmd} page 0" "")
      (label :class "section-label" :hexpand true :xalign 0 :text "Allowed apps"))
    (label :class "muted" :xalign 0 :wrap true :width 480
           :text "Selected apps can interrupt Do not disturb. Changes save immediately.")
    (button :class "compact-btn" :active {desktop.apps_editable && arraylength(desktop.apps) > 0}
            :onclick "${qs_cmd} apps-search" "  Search apps…")
    (label :visible {desktop.dnd_available && !desktop.apps_editable} :class "muted" :xalign 0 :wrap true :width 480
           :text "Notifications are paused. Resume them before changing app exceptions.")
    (label :visible {!desktop.apps_available} :class "muted" :xalign 0 :wrap true :width 480 :text {desktop.apps_error})
    (label :visible {desktop.apps_available && arraylength(desktop.apps) == 0}
           :class "muted" :xalign 0 :wrap true :width 480
           :text "Apps appear here after sending a notification.")
    (box :orientation "v" :space-evenly false :spacing 10
      (for app in {desktop.apps}
        (button :timeout "10s" :class "device ${app.allowed ? 'selected' : ''}"
                :active {desktop.dnd_available && desktop.apps_available && desktop.apps_editable}
                :tooltip "${app.name}: ${app.allowed ? 'allowed during DND' : 'silenced during DND'}"
                :onclick "${desktop_cmd} allow-app ${app.id}"
          (box :space-evenly false :spacing 12
            (label :width 24 :text {app.allowed ? "☑" : "☐"})
            (label :visible {arraylength(app.icons) == 0} :width 24 :text "")
            (for icon in {app.icons}
              (image :path icon :image-width 24 :image-height 24))
            (label :hexpand true :xalign 0 :limit-width 25 :tooltip {app.name} :text {app.name})
            (label :text {app.allowed ? "Allowed" : "Silenced"})))))))

(defwidget quick-controls []
  (box :orientation "v" :space-evenly false :spacing 24
    (slider-row :icon {qs.vol_muted ? "" : ""} :text {qs.vol_muted ? "Volume · muted" : "Volume"}
                :value {qs.vol} :cmd "${qs_cmd} vol {}" :icon-cmd "${qs_cmd} mute")
    (slider-row :icon "󰃟" :text "Brightness" :value {qs.bright} :cmd "${qs_cmd} bright {}")
    (button :timeout "10s" :class "compact-btn" :onclick "${qs_cmd} timer"
            :tooltip "Start a countdown or stopwatch. Active timers appear beside the clock."
      (box :space-evenly false :spacing 12
        (label :hexpand true :xalign 0 :text " Timer & stopwatch")
        (label :text "Open ›")))
    (box :orientation "v" :space-evenly false :spacing 12
      (box :spacing 12 :space-evenly true
        (tile :icon {qs.mic_muted ? "" : ""} :text "Microphone" :detail {qs.mic_muted ? "Muted" : "On"}
              :on {!qs.mic_muted} :cmd "${qs_cmd} mic")
        (tile :icon "" :text "Keyboard" :detail {qs.kbd} :on {qs.kbd == "VI"} :cmd "${qs_cmd} kbd"))
      (box :spacing 12 :space-evenly true
        (tile :icon "" :text "Display" :detail "${qs.hz} Hz" :on {qs.hz >= 144} :cmd "${qs_cmd} hz")
        (tile :icon {qs.wifi == "" ? "󰖪" : ""} :text "Wi-Fi" :detail {qs.wifi == "" ? "Offline" : qs.wifi}
              :on {qs.wifi != ""} :cmd "${qs_cmd} wifi")))
    (box :space-evenly false :spacing 10
      (button :timeout "10s" :hexpand true :class "afk-toggle ${desktop.dnd ? 'afk-on' : ''}"
              :tooltip "Silence notifications except allowed apps. Keep silenced notifications in History."
              :active {desktop.dnd_available} :onclick "${desktop_cmd} dnd"
        (box :space-evenly false :spacing 12
          (label :width 24 :text {desktop.dnd ? "" : ""})
          (label :hexpand true :xalign 0 :text "Do not disturb")
          (label :text {desktop.dnd_available ? (desktop.dnd ? (desktop.allowed_count > 0 ? "On · ${desktop.allowed_count} allowed" : "On") : "Off") : "Unavailable"})))
      (button :class "compact-btn" :tooltip "Choose apps allowed during Do not disturb"
              :onclick "${qs_cmd} page 3" ""))
    (button :timeout "1m" :class "afk-toggle ${qs.battery.enabled ? 'afk-on' : ''}"
            :tooltip {qs.battery.detail} :active {qs.battery.available}
            :onclick "${qs_cmd} battery"
      (box :space-evenly false :spacing 12
        (label :width 24 :text "")
        (label :hexpand true :xalign 0 :text "Battery Saver")
        (label :text {qs.battery.enabled ? "On" : "Off"})))
    (button :timeout "10s" :class "afk-toggle ${desktop.afk ? 'afk-on' : ''}"
            :tooltip "Keep screen awake while lid is open. Lid close or sleep turns this off."
            :onclick "${afk_cmd} toggle"
      (box :space-evenly false :spacing 12
        (label :width 24 :text "")
        (label :hexpand true :xalign 0 :text "AFK · keep awake")
        (label :text {desktop.afk ? "On" : "Off"})))
    (box :class "media" :space-evenly false :spacing 12
      (label :class "media-text" :hexpand true :xalign 0 :limit-width 27 :tooltip {qs.media}
             :text {qs.media == "" ? "No media playing" : qs.media})
      (button :class "media-btn" :tooltip "Previous" :onclick "${qs_cmd} prev" "")
      (button :class "media-btn" :tooltip "Play / pause" :onclick "${qs_cmd} play" {qs.playing ? "" : ""})
      (button :class "media-btn" :tooltip "Next" :onclick "${qs_cmd} next" ""))))

(defwidget flyout []
  (box :class "card qs-panel" :orientation "v" :space-evenly false :spacing 20
    (box :class "header" :space-evenly false :spacing 16
      (box :orientation "v" :space-evenly false :hexpand true :spacing 8
        (label :class "settings-title" :xalign 0 :text "Quick settings")
        (label :class "date" :xalign 0 :text {formattime(EWW_TIME, "%a, %d %B")}))
      (label :class "clock" :text {formattime(EWW_TIME, "%I:%M %p")}))
    (box :class "settings-tabs" :space-evenly true :spacing 8
      (settings-tab :text "Controls" :index 0)
      (settings-tab :text "Audio" :index 1)
      (settings-tab :text "History" :index 2))
    (stack :selected qs_page :transition "none" :same-size false :vexpand true
      (scroll :vexpand true :hscroll false (quick-controls))
      (scroll :vexpand true :hscroll false (audio-devices))
      (scroll :vexpand true :hscroll false (notification-history))
      (scroll :vexpand true :hscroll false (allowed-apps)))
    (box :class "footer" :space-evenly false :spacing 12
      (label :class "footer-text" :hexpand true :xalign 0 :text "  ${qs.gpu}")
      (button :class "footer-btn" :onclick "${qs_cmd} updates" {updates}))))

;; Transparent full-screen catcher: clicking outside the card closes it.
(defwidget closer []
  (eventbox :onclick "${qs_cmd} close" (box)))

(defwindow closer
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%")
  :stacking "fg"
  :wm-ignore true
  :windowtype "desktop"
  (closer))

;; 22px matches the i3 window edge; 52px sits just under the 8+36px bar.
(defwindow flyout [?panel_height]
  :monitor 0
  :geometry (geometry :x "-22px" :y "52px" :width "560px" :height {panel_height ?: "780px"} :anchor "top right")
  :stacking "fg"
  :wm-ignore false
  :windowtype "dialog"
  (flyout))
