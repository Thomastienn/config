{
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Artifact",
      "SendFeedback",
      "ScheduleWakeup",
      "ReportFindings",
      "ListAgents",
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "SendToProject",
      "SendToProjectContext",
      "PushNotification",
      "RemoteTrigger",
      "CronCreate",
      "CronDelete",
      "CronList",
      "AskUserQuestion"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "rederive": "user-invocable-only"
  },
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/thomas_config/scripts/claude-notify.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/thomas_config/scripts/claude-notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 15
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "impeccable@impeccable": true,
    "beads@beads-marketplace": false,
    "agent-browser@agent-browser": true,
    "drawio@drawio": true,
    "canva@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "steveyegge/beads"
      }
    },
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser"
      }
    },
    "drawio": {
      "source": {
        "source": "github",
        "repo": "jgraph/drawio-mcp"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": "auto"
    }
  },
  "autoMemoryEnabled": false,
  "theme": "custom:desktop",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(bd:*) in /home/thomas/CodeBase/Rabbithole",
      "Bash(trash:*) in /home/thomas/CodeBase/Rabbithole"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: private (Thomastienn/Rabbithole, confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: default branch unknown (origin/HEAD unset); no rulesets listed; no protected branches listed via gh",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (Thomastienn/Rabbithole) and its origin remote only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — this repo's .gitignore excludes `.beads-credential-key`, and `test/providers/credential-boundary.slow.mjs` and the `src/themes/paperback/` files appear sensitive-named but are config-derived, not usage-corroborated",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (local learning workspace app — Rabbithole)",
      "**Trusted repo**: /home/thomas/CodeBase/Rabbithole (origin: github.com:Thomastienn/Rabbithole.git), private visibility",
      "**Org-specific CLIs**: None configured — personal/hobby tooling observed (bd, npx, trash, astryx, agent-browser, sqlite3) are routine dev CLIs, not org-specific"
    ]
  },
  "hasCompletedOnboarding": true
}
