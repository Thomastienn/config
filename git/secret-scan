#!/usr/bin/env bash
# Refuse commits and pushes that contain credentials. Called by the one-line
# hooks in git/hooks/, also when Beads has copied that line into a repository's
# own hooks: secret-scan <hook path> [hook arguments...] < hook input
set -euo pipefail
# Clients like Neogit run `git -c color.ui=always`, which reaches the scanners'
# git calls; coloured diffs hide every finding from gitleaks.
export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }'color.ui'='never' 'color.diff'='never'"

hook="$(basename -- "$1")"
hook_dir="$(dirname -- "$1")"
shift
here="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
input="$(mktemp)"
trap 'rm -f -- "$input"' EXIT
cat >"$input"

need() {
  command -v "$1" >/dev/null && return
  echo "Secret scan needs $1 (brew install $1). Bypass once with --no-verify." >&2
  exit 1
}

case "$hook" in
  pre-commit)
    need gitleaks
    gitleaks git --pre-commit --staged --redact --no-banner --log-level warn -v .
    ;;
  pre-push)
    need gitleaks
    need trufflehog
    # Scan only commits the pushed-to remote does not have; a URL remote matches
    # no tracking refs, so everything reachable is scanned.
    while read -r _ local_sha _ _; do
      [[ $local_sha =~ ^0+$ ]] && continue  # branch deletion
      [[ -n "$(git rev-list -n 1 "$local_sha" --not --remotes="$1")" ]] || continue
      gitleaks git --redact --no-banner --log-level warn -v --log-opts="$local_sha --not --remotes=$1" .
      # Any boundary commit is on the remote, so base..local covers every new commit.
      base="$(git rev-list --boundary "$local_sha" --not --remotes="$1" | sed -n 's/^-//p' | head -n 1)"
      # The main checkout: trufflehog cannot open a worktree's .git file.
      repo="$(dirname -- "$(git rev-parse --path-format=absolute --git-common-dir)")"
      trufflehog git "file://$repo" --no-update --fail --log-level=-1 --branch "$local_sha" ${base:+--since-commit "$base"} \
        2> >(grep -v -e 'TruffleHog\. Unearth' -e '^$' >&2)  # drop the banner, keep errors
    done <"$input"
    ;;
esac
[[ $hook == pre-commit || $hook == pre-push ]] && echo "secret scan: $hook ok" >&2

# From the global core.hooksPath, also run the repository's own hook, which that
# setting otherwise hides (git-lfs pre-push, pre-commit). Copies inside a
# repository's hooks fall through to the rest of their file instead.
[[ "$(readlink -f -- "$hook_dir")" == "$here/hooks" ]] || exit 0
repo_hook="$(git rev-parse --git-common-dir)/hooks/$hook"
[[ -x $repo_hook ]] || exit 0
"$repo_hook" "$@" <"$input"
