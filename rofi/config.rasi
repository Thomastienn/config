/*
 * ROFI THEME: COZY MINT
 * Centered list, maximum readability, no distractions
 */

configuration {
    font: "ComicShannsMono Nerd Font 14";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "kitty";
    drun-display-format: "{name}";
    display-drun: "";
    display-window: "";
    display-run: "";
    modi: "drun,window,run";
    scroll-method: 0;
    disable-history: false;
    sidebar-mode: false;
}

* {
    /* Wallpaper mint and lavender over warm charcoal */
    bg: #191B19D1;
    bg-alt: #272C2799;
    fg: #EEE8DC;
    fg-dim: #ABAFA4;
    accent: #A7CCAE;
    selected-bg: #403849;
    border-color: #46534A;
    
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 480px;
    background-color: @bg;
    border: 1px solid;
    border-color: @border-color;
    border-radius: 14px;
    padding: 0;
}

mainbox {
    children: [ "inputbar", "message", "listview" ];
    spacing: 0;
    background-color: transparent;
}

inputbar {
    children: [ "entry" ];
    padding: 16px 20px;
    background-color: @bg-alt;
    border: 0 0 1px 0;
    border-color: @border-color;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-dim;
    text-color: @fg;
    cursor: text;
    background-color: transparent;
}

message {
    padding: 8px 20px;
    background-color: transparent;
    border: 0 0 1px 0;
    border-color: @border-color;
}

textbox {
    text-color: @fg-dim;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: true;
    fixed-columns: true;
    cycle: true;
    scrollbar: false;
    padding: 8px 0;
    background-color: transparent;
}

element {
    padding: 10px 20px;
    spacing: 12px;
    background-color: transparent;
}

element-icon {
    size: 24px;
    background-color: transparent;
    vertical-align: 0.5;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: #DBA0AA;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: @fg;
}

element selected.urgent {
    background-color: @selected-bg;
    text-color: #DBA0AA;
}

element selected.active {
    background-color: @selected-bg;
    text-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
    vertical-align: 0.5;
}
