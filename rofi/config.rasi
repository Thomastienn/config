/*
 * ROFI THEME: COZY MINT
 * Frosted card, pill search, fuzzy everything
 */

configuration {
    font: "ComicShannsMono Nerd Font 14";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "kitty";
    modes: "drun,window,run,ssh,filebrowser";
    display-drun: "Apps";
    display-window: "Windows";
    display-run: "Run";
    display-ssh: "SSH";
    display-filebrowser: "Files";
    drun-display-format: "{name}[<span size='small' foreground='#ABAFA4'>  ·  {generic}</span>]";
    window-format: "{w:3}{c:14}{t}";
    drun-match-fields: "name,generic,exec,keywords";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    filebrowser {
        directories-first: true;
        sorting-method: "name";
    }
}

* {
    /* Wallpaper mint and lavender over warm charcoal */
    bg: #191B19D1;
    bg-alt: #272C2799;
    fg: #EEE8DC;
    fg-dim: #ABAFA4;
    accent: #A7CCAE;
    urgent: #DBA0AA;
    selected-bg: #403849;
    border-color: #46534A;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 600px;
    background-color: @bg;
    border: 1px solid;
    border-color: @border-color;
    border-radius: 16px;
    padding: 14px;
}

mainbox {
    border: 0;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
    spacing: 12px;
}

inputbar {
    border: 0;
    children: [ "textbox-search", "entry", "prompt" ];
    spacing: 12px;
    padding: 12px 16px;
    background-color: @bg-alt;
    border-radius: 12px;
}

textbox-search {
    expand: false;
    str: "";
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-dim;
    text-color: @fg;
    cursor-color: @accent;
    cursor: text;
    vertical-align: 0.5;
}

prompt {
    padding: 2px 10px;
    background-color: @selected-bg;
    text-color: @accent;
    border-radius: 8px;
    vertical-align: 0.5;
}

message {
    border: 0;
    padding: 8px 16px;
    background-color: @bg-alt;
    border-radius: 10px;
}

textbox {
    text-color: @fg-dim;
}

listview {
    border: 0;
    lines: 8;
    columns: 1;
    spacing: 4px;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
}

element {
    padding: 8px 14px;
    spacing: 14px;
    border: 0 0 0 3px;
    border-color: transparent;
    border-radius: 10px;
    cursor: pointer;
}

element-icon {
    size: 28px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    text-color: inherit;
    highlight: bold #A7CCAE;
    vertical-align: 0.5;
    cursor: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @selected-bg;
    border-color: @accent;
}

element selected.urgent {
    text-color: @urgent;
}

element selected.active {
    text-color: @accent;
}

mode-switcher {
    border: 0;
    spacing: 8px;
}

button {
    padding: 6px 0;
    background-color: @bg-alt;
    text-color: @fg-dim;
    border-radius: 10px;
    cursor: pointer;
}

button selected {
    background-color: @selected-bg;
    text-color: @accent;
}
