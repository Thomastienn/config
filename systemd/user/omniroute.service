[Unit]
Description=Local OmniRoute gateway
ConditionPathExists=/home/linuxbrew/.linuxbrew/bin/omniroute

[Service]
Type=simple
UMask=0077
# Upstream binds all interfaces unless OMNIROUTE_SERVER_HOST is set.
Environment=OMNIROUTE_SERVER_HOST=127.0.0.1 PORT=20128
Environment="PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/linuxbrew/.linuxbrew/bin/omniroute serve --no-open --no-tray
Restart=on-failure
RestartSec=5
