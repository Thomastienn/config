# Cozy Mint notifications: quiet cards, clear titles, compact system controls.
[global]
    monitor = 0
    follow = none

    width = 360
    height = (0, 240)
    origin = top-right
    offset = (24, 58)
    scale = 0
    notification_limit = 3

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 324
    progress_bar_corner_radius = 3

    icon_position = left
    min_icon_size = 32
    max_icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark, Adwaita
    default_icon = dialog-information
    icon_corner_radius = 0

    font = ComicShannsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<b><span size='large'>%s</span></b>\n<span alpha='85%%'>%b</span>\n<span size='small' alpha='80%%'>%a</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    separator_height = 0
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 14
    frame_width = 1
    gap_size = 12
    separator_color = frame
    sort = yes
    transparency = 0
    corner_radius = 14

    sticky_history = yes
    history_length = 30
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/brave
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current
    idle_threshold = 120

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#191B19"
    foreground = "#ABAFA4"
    frame_color = "#46534A"
    highlight = "#A7CCAE"
    timeout = 4

[urgency_normal]
    background = "#191B19"
    foreground = "#EEE8DC"
    frame_color = "#C0AFD5"
    highlight = "#A7CCAE"
    timeout = 6

[urgency_critical]
    background = "#3A2730"
    foreground = "#EEE8DC"
    frame_color = "#DBA0AA"
    highlight = "#DBA0AA"
    timeout = 0

# SVG paths cover Papirus status icons missing from its 32px theme lookup.
[volume-up]
    appname = "volume"
    summary = "Volume Up"
    format = "<b>Volume</b>  <span foreground='#A7CCAE'>%n%%</span>"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-audio-volume-high.svg
    timeout = 2

[volume-down]
    appname = "volume"
    summary = "Volume Down"
    format = "<b>Volume</b>  <span foreground='#A7CCAE'>%n%%</span>"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-audio-volume-low.svg
    timeout = 2

[volume-unmuted]
    appname = "volume"
    summary = "Unmuted"
    format = "<b>Volume unmuted</b>"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-audio-volume-high.svg
    timeout = 2

[volume-muted]
    appname = "volume"
    summary = "Muted"
    format = "<b>Volume muted</b>"
    foreground = "#ABAFA4"
    frame_color = "#46534A"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-audio-volume-muted.svg
    timeout = 2

[brightness-up]
    appname = "brightness"
    summary = "Brightness Up"
    format = "<b>Brightness</b>  <span foreground='#C0AFD5'>%n%%</span>"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-display-brightness-high.svg
    highlight = "#C0AFD5"
    timeout = 2

[brightness-down]
    appname = "brightness"
    summary = "Brightness Down"
    format = "<b>Brightness</b>  <span foreground='#C0AFD5'>%n%%</span>"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-display-brightness-low.svg
    highlight = "#C0AFD5"
    timeout = 2

[mic-unmuted]
    appname = "microphone"
    summary = "*Unmuted*"
    format = "<b>Microphone unmuted</b>"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/microphone-sensitivity-high.svg
    timeout = 2

[mic-muted]
    appname = "microphone"
    summary = "*Muted*"
    format = "<b>Microphone muted</b>"
    foreground = "#ABAFA4"
    frame_color = "#46534A"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/microphone-sensitivity-muted.svg
    timeout = 2

# App rules supply an icon only when the sender does not provide one.
[taskwarrior]
    appname = "Taskwarrior"
    default_icon = /usr/share/icons/Papirus-Dark/24x24/actions/view-task.svg

[screenshot]
    appname = "*creenshot*"
    summary = "*creenshot*"
    default_icon = /usr/share/icons/Papirus-Dark/symbolic/devices/camera-photo-symbolic.svg
    timeout = 3

[spotify]
    appname = "*potify*"
    default_icon = spotify
    timeout = 4

[battery]
    appname = "*attery*"
    urgency = critical
    background = "#3A2730"
    foreground = "#EEE8DC"
    frame_color = "#DBA0AA"
    default_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-battery-low.svg

[network]
    appname = "*etwork*"
    default_icon = /usr/share/icons/Papirus-Dark/symbolic/devices/network-wireless-symbolic.svg
    timeout = 4

[discord]
    appname = "discord"
    default_icon = discord
    timeout = 5

[discord-dm]
    appname = "discord"
    summary = "Direct Message"
    default_icon = discord
    timeout = 5

[kitty]
    appname = "kitty"
    default_icon = utilities-terminal
    timeout = 5

[brave]
    appname = "Brave*"
    default_icon = brave-browser
    timeout = 5

[brave-download]
    appname = "Brave*"
    summary = "*ownload*"
    default_icon = /usr/share/icons/Papirus-Dark/24x24/actions/document-save.svg
    timeout = 4

[updates]
    appname = "*pdate*"
    summary = "*pdate*"
    default_icon = /usr/share/icons/Papirus-Dark/symbolic/status/software-update-available-symbolic.svg
    timeout = 8
