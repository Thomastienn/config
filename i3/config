# i3 config file (v4)
# Cozy Mint Theme - Vim-style keybinds

# ================================================================
# GENERAL SETTINGS
# ================================================================
set $mod Mod4
font pango:ComicShannsMono Nerd Font Propo 11
title_align center
floating_modifier $mod
focus_follows_mouse no

# ================================================================
# VOLUME CONTROL
# ================================================================
# shortcut: Volume up
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send -t 1000 -a "volume" -h "int:value:$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+%' | head -1 | tr -d '%')" -r 1111 "Volume Up"
# shortcut: Volume down
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && notify-send -t 1000 -a "volume" -h "int:value:$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+%' | head -1 | tr -d '%')" -r 1111 "Volume Down"
# shortcut: Toggle speaker mute
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && sleep 0.1 && notify-send -t 1000 -a "volume" -r 1111 "$(pactl get-sink-mute @DEFAULT_SINK@ | grep -q 'yes' && echo 'Muted' || echo 'Unmuted')"

# Mic mute toggle with visual feedback
# shortcut: Toggle microphone mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && sleep 0.1 && notify-send -t 1000 -a "microphone" -r 1112 "$(pactl get-source-mute @DEFAULT_SOURCE@ | grep -q 'yes' && echo 'Mic Muted' || echo 'Mic Unmuted')" && polybar-msg action microphone hook 0

# ================================================================
# BRIGHTNESS CONTROL
# ================================================================
