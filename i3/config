bindsym XF86MonBrightnessUp exec --no-startup-id /home/thomas/thomas_config/scripts/brightness.sh up
# shortcut: Brightness down
bindsym XF86MonBrightnessDown exec --no-startup-id /home/thomas/thomas_config/scripts/brightness.sh down

