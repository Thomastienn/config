set $inactive-bg-color   #191B19
set $inactive-border-color #46534A
set $text-color          #EEE8DC
set $inactive-text-color #ABAFA4
set $urgent-bg-color     #3A2730
set $urgent-color        #DBA0AA
set $indicator-color     #C0AFD5
set $border-color        #A7CCAE

# Window colors         border              background          text                 indicator           child_border
client.focused          $border-color       $border-color       $inactive-bg-color   $indicator-color    $border-color
client.focused_tab_title $border-color      $border-color       $inactive-bg-color
client.unfocused        $bg-color           $inactive-bg-color  $inactive-text-color $inactive-bg-color  $inactive-border-color
