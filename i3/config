# ================================================================
# WINDOW RULES
# ================================================================
# Native icons and padded titles also apply to tabbed and stacked layouts.
for_window [all] title_window_icon padding 6px
for_window [class=".*"] title_format "  <b>%title</b>  "

# Border settings
default_border pixel 1
default_floating_border pixel 1
for_window [class=".*"] border pixel 1
gaps inner 10
gaps outer 5

# Force borders on Brave - match exact class names
for_window [class="Brave-browser"] border pixel 1

# Floating windows
for_window [class="(?i)^copyq$"] floating enable, resize set 640 px 480 px, move position center
for_window [class="^task-dropdown$"] floating enable, resize set 80 ppt 50 ppt, move position center, move scratchpad
for_window [class="Pavucontrol"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
