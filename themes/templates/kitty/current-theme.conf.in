# Cozy Mint, with the Kanagawabones ANSI palette below.
# vim:ft=kitty
## name: Cozy Mint
## author: Michael Chris Lopez
## license: MIT
## upstream: https://github.com/mcchrish/zenbones.nvim/raw/main/extras/kitty/kanagawabones.conf
## blurb: A zenbones variant inspired by Kanagawa.
foreground                      {{colors.text}}
background                      {{colors.background}}
selection_foreground            {{colors.text}}
selection_background            {{colors.selection}}
# Cursor colors
cursor                          {{colors.primary}}
cursor_text_color               {{colors.background}}
# URL underline color when hovering with mouse
# kitty window border colors
# OS Window titlebar colors
# Tab bar colors
active_tab_foreground           {{colors.background}}
active_tab_background           {{colors.primary}}
inactive_tab_foreground         {{colors.muted}}
inactive_tab_background         {{colors.surface}}
# Colors for marks (marked text in the terminal)
# The basic 16 colors
# black
color0 {{ansi.0}}
color8 {{ansi.8}}
# red
color1 {{ansi.1}}
color9 {{ansi.9}}
# green
color2 {{ansi.2}}
color10 {{ansi.10}}
# yellow
color3 {{ansi.3}}
color11 {{ansi.11}}
# blue
color4 {{ansi.4}}
color12 {{ansi.12}}
# magenta
color5 {{ansi.5}}
color13 {{ansi.13}}
# cyan
color6 {{ansi.6}}
color14 {{ansi.14}}
# white
color7 {{ansi.7}}
color15 {{ansi.15}}
# You can set the remaining 240 colors as color16 to color255.

font_family {{fonts.terminal}}
font_size {{fonts.terminal_size}}
