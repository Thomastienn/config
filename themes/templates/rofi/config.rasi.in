/*
 * ROFI THEME: THE LINE
 * Same language as Polybar, Eww and tmux: the chosen row is a bead in the line
 * colour, and modes are stops on a line along the bottom.
 */

configuration {
    font: "{{fonts.ui}} 14";
    show-icons: true;
    icon-theme: "{{desktop.icons}}";
    terminal: "kitty";
    ssh-command: "/bin/sh -c 'exec /usr/bin/python3 \"$HOME/thomas_config/scripts/ssh-launcher.py\" \"$@\"' -- {host}";
    modes: "drun,window,run,ssh,filebrowser";
    display-drun: "Apps";
    display-window: "Windows";
    display-run: "Run";
    display-ssh: "SSH";
    display-filebrowser: "Files";
    drun-display-format: "{name}[<span size='small' alpha='60%'>  ·  {generic}</span>]";
    window-format: "{w:3}{c:14}{t}";
    drun-match-fields: "name,generic,exec,keywords";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    filebrowser {
        directories-first: true;
        sorting-method: "name";
    }
}

* {
    bg: {{colors.background}}D1;
    bg-alt: {{colors.surface}}99;
    plate: {{colors.surface}};
    ink: {{colors.background}};
    fg: {{colors.text}};
    fg-dim: {{colors.muted}};
    accent: {{colors.primary}};
    urgent: {{colors.error}};
    transfer: {{colors.secondary}};
    selected-bg: {{colors.shade4}};

    background-color: transparent;
    text-color: @fg;
}

/* The frame is drawn in the line colour so picom's window-edge shader turns it
   into the same gradient as every i3 window; width and radius match that shader. */
window {
    width: 640px;
    background-color: @bg;
    border: 2px solid;
    border-color: @accent;
    border-radius: 14px;
    padding: 16px;
}

mainbox {
    border: 0;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
    spacing: 12px;
}

inputbar {
    border: 0;
    children: [ "textbox-search", "entry", "prompt" ];
    spacing: 12px;
    padding: 6px;
    background-color: @bg-alt;
    border-radius: 100%;
}

/* A stop: ink glyph on a disc in the line colour. */
textbox-search {
    expand: false;
    str: "󰍉";
    width: 36px;
    padding: 8px 0;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: @accent;
    text-color: @ink;
    border-radius: 100%;
}

entry {
    placeholder: "Where to?";
    placeholder-color: @fg-dim;
    text-color: @fg;
    cursor-color: @accent;
    cursor: text;
    vertical-align: 0.5;
}

prompt {
    padding: 0 14px;
    background-color: @transfer;
    text-color: @ink;
    border-radius: 100%;
    vertical-align: 0.5;
}

message {
    border: 0;
    padding: 8px 16px;
    background-color: @bg-alt;
    border-radius: 12px;
}

textbox {
    text-color: @fg-dim;
}

listview {
    border: 0;
    lines: 8;
    columns: 1;
    spacing: 2px;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
}

element {
    padding: 7px 14px;
    spacing: 14px;
    border: 0;
    border-radius: 100%;
    cursor: pointer;
}

element-icon {
    size: 28px;
    vertical-align: 0.5;
    cursor: inherit;
}

/* Matches are bold and underlined in the row's own colour, so they stay legible on the bead. */
element-text {
    text-color: inherit;
    highlight: bold underline;
    vertical-align: 0.5;
    cursor: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element selected.normal,
element selected.active {
    background-color: @accent;
    text-color: @ink;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @ink;
}

/* Modes are stops on the line: nineteen even steps with only the middle one lit
   draw one soft rule, and the beads cover it. */
mode-switcher {
    border: 0;
    spacing: 28px;
    background-image: linear-gradient(to bottom, transparent, transparent, transparent, transparent, transparent, transparent, transparent, transparent, transparent, {{colors.primary}}, transparent, transparent, transparent, transparent, transparent, transparent, transparent, transparent, transparent);
}

button {
    padding: 5px 0;
    background-color: @plate;
    text-color: @fg-dim;
    border-radius: 100%;
    cursor: pointer;
}

button selected {
    background-color: @accent;
    text-color: @ink;
}
