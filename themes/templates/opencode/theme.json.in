{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "#{{hex.primary}}",
    "secondary": "#{{hex.secondary}}",
    "accent": "#{{hex.accent}}",
    "error": "#{{hex.error}}",
    "warning": "#{{hex.warning}}",
    "success": "#{{hex.primary}}",
    "info": "#{{hex.accent}}",
    "text": "#{{hex.text}}",
    "textMuted": "#{{hex.muted}}",
    "selectedListItemText": "#{{hex.background}}",
    "background": "#{{hex.background}}",
    "backgroundPanel": "#{{hex.surface}}",
    "backgroundElement": "#{{hex.shade4}}",
    "backgroundMenu": "#{{hex.surface}}",
    "border": "#{{hex.border}}",
    "borderActive": "#{{hex.primary}}",
    "borderSubtle": "#{{hex.pane_border}}",
    "diffAdded": "{{ansi.2}}",
    "diffRemoved": "{{ansi.1}}",
    "diffContext": "#{{hex.muted}}",
    "diffHunkHeader": "#{{hex.muted}}",
    "diffHighlightAdded": "{{ansi.10}}",
    "diffHighlightRemoved": "{{ansi.9}}",
    "diffAddedBg": "#2A472F",
    "diffRemovedBg": "#472A2E",
    "diffContextBg": "#{{hex.surface}}",
    "diffLineNumber": "#{{hex.muted}}",
    "diffAddedLineNumberBg": "#232F25",
    "diffRemovedLineNumberBg": "#2F2325",
    "markdownText": "#{{hex.text}}",
    "markdownHeading": "#{{hex.secondary}}",
    "markdownLink": "#{{hex.primary}}",
    "markdownLinkText": "#{{hex.accent}}",
    "markdownCode": "#{{hex.primary}}",
    "markdownBlockQuote": "#{{hex.warning}}",
    "markdownEmph": "#{{hex.warning}}",
    "markdownStrong": "#{{hex.secondary}}",
    "markdownHorizontalRule": "#{{hex.muted}}",
    "markdownListItem": "#{{hex.primary}}",
    "markdownListEnumeration": "#{{hex.accent}}",
    "markdownImage": "#{{hex.primary}}",
    "markdownImageText": "#{{hex.accent}}",
    "markdownCodeBlock": "#{{hex.text}}",
    "syntaxComment": "#{{hex.muted}}",
    "syntaxKeyword": "{{ansi.5}}",
    "syntaxFunction": "{{ansi.4}}",
    "syntaxVariable": "#{{hex.text}}",
    "syntaxString": "{{ansi.2}}",
    "syntaxNumber": "{{ansi.3}}",
    "syntaxType": "#{{hex.warning}}",
    "syntaxOperator": "{{ansi.6}}",
    "syntaxPunctuation": "#{{hex.text}}"
  }
}
