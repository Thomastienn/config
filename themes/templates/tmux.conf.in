# ================================================================
# TMUX CONFIGURATION - MODERN AESTHETIC DESIGN
# ================================================================

# ----------------------------------------------------------------
# TERMINAL & COLOR SETTINGS
# ----------------------------------------------------------------
# Better terminal support with true color
set-option -g default-terminal "xterm-256color"
set-option -ga terminal-overrides ",*256col*:Tc"
set-option -g focus-events on

# Enable system clipboard integration
set-option -g set-clipboard on
set-option -ga terminal-overrides ",xterm*:Tc"
set-option -g allow-passthrough on

# Copy bindings using xclip
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"

# Remove delay when switching between Vim modes
set -sg escape-time 0

# ----------------------------------------------------------------
# GENERAL SETTINGS
# ----------------------------------------------------------------
# Use vim keybindings
set-window-option -g mode-keys vi

# Enable mouse support
set -g mouse on

# Start windows and panes at 1, not 0
set -g base-index 1
setw -g pane-base-index 1

# Renumber windows when one is closed
set -g renumber-windows on

# Increase scrollback buffer size
set -g history-limit 50000

# Increase tmux messages display duration
set -g display-time 4000

# Refresh status line every 5 seconds
set -g status-interval 5

# ----------------------------------------------------------------
# KEY BINDINGS
# ----------------------------------------------------------------
# Make new panes inherit pwd path
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Better pane navigation (vim-like)
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Move current window left/right and follow it
bind -r < swap-window -d -t -1
bind -r > swap-window -d -t +1

# Resize panes with arrow keys
bind -r Left resize-pane -L 5
bind -r Down resize-pane -D 5
bind -r Up resize-pane -U 5
bind -r Right resize-pane -R 5

# Quick reload of config file
bind r source-file ~/.tmux.conf \; display-message "Config reloaded!"

# ----------------------------------------------------------------
# VISUAL DESIGN - THE LINE
# ----------------------------------------------------------------
# Same language as Polybar and Eww: windows are numbered stops on one line,
# the session is the line's badge, and amber marks a mode that bends normal
# behaviour (prefix held, copy mode, zoom, synchronised panes).
%hidden line="{{colors.primary}}"
%hidden transfer="{{colors.secondary}}"
%hidden mode="{{colors.warning}}"
%hidden alert="{{colors.error}}"
%hidden ink="{{colors.background}}"
%hidden text="{{colors.text}}"
%hidden dim="{{colors.muted}}"
%hidden rail="{{colors.separator}}"
%hidden plate="{{colors.surface}}"
%hidden idle="{{colors.pane_border}}"

# Stop numbers 1-10 from the Material Design set, filled for the current window;
# later windows share the 9+ stop.
%hidden stop_on="#{?#{==:#I,1},\U000F0CA0,}#{?#{==:#I,2},\U000F0CA2,}#{?#{==:#I,3},\U000F0CA4,}#{?#{==:#I,4},\U000F0CA6,}#{?#{==:#I,5},\U000F0CA8,}#{?#{==:#I,6},\U000F0CAA,}#{?#{==:#I,7},\U000F0CAC,}#{?#{==:#I,8},\U000F0CAE,}#{?#{==:#I,9},\U000F0CB0,}#{?#{==:#I,10},\U000F0FEC,}#{?#{e|>:#I,10},\U000F0CB2,}"
%hidden stop_off="#{?#{==:#I,1},\U000F0CA1,}#{?#{==:#I,2},\U000F0CA3,}#{?#{==:#I,3},\U000F0CA5,}#{?#{==:#I,4},\U000F0CA7,}#{?#{==:#I,5},\U000F0CA9,}#{?#{==:#I,6},\U000F0CAB,}#{?#{==:#I,7},\U000F0CAD,}#{?#{==:#I,8},\U000F0CAF,}#{?#{==:#I,9},\U000F0CB1,}#{?#{==:#I,10},\U000F0FED,}#{?#{e|>:#I,10},\U000F0CB3,}"

# ----------------------------------------------------------------
# STATUS BAR - STOPS ON THE LINE
# ----------------------------------------------------------------
set -g status-position bottom
set -g status-justify absolute-centre
set -g status-style "bg=default,fg=$text"
set -g status-left-length 100
set -g status-right-length 100

# Left: the line badge (amber while prefix is held), then a transfer bead naming the ssh target of an ssh'd pane.
set -g status-left "#{?client_prefix,#[fg=$mode],#[fg=$line]}#{?client_prefix,#[bg=$mode],#[bg=$line]}#[fg=$ink,bold] \U000F06AC #S #[bg=default]#{?client_prefix,#[fg=$mode],#[fg=$line]}#[nobold] #(ps -t #{pane_tty} -o command= 2>/dev/null | awk '\$1 ~ \"(^|/)ssh\$\" {print \"#[fg=$transfer]#[bg=$transfer,fg=$ink] \U000F06AE \" (\$2 == \"--\" ? \$3 : \$2) \" #[bg=default,fg=$transfer]\"; exit}')"

# Right: one amber bead per active mode. System status lives in Polybar and Conky; Git state in the shell prompt.
set -g status-right "#{?pane_synchronized,#[fg=$mode]#[bg=$mode]#[fg=$ink]#[bold] \U000F04E6 sync #[bg=default]#[fg=$mode] ,}#{?pane_in_mode,#[fg=$mode]#[bg=$mode]#[fg=$ink]#[bold] \U000F018F #{s/-mode//:pane_mode} #[bg=default]#[fg=$mode],}"

# Current stop filled in the line colour; a bell turns a stop rose, activity lavender.
setw -g window-status-current-format "#[fg=$line]$stop_on #[fg=$text,bold]#W#{?window_zoomed_flag, #[fg=$mode]\U000F0293,}#[default]"
setw -g window-status-format "#{?window_bell_flag,#[fg=$alert],#{?window_activity_flag,#[fg=$transfer],#[fg=$dim]}}$stop_off #[fg=$dim]#W#{?window_zoomed_flag, #[fg=$mode]\U000F0293,}#[default]"
setw -g window-status-separator "#[fg=$rail] ── #[default]"
# The formats above colour bells and activity themselves.
setw -g window-status-activity-style default
setw -g window-status-bell-style default

# Window names: folder for a shell, program otherwise (node's script name, so codex reads "codex")
set -g automatic-rename on
set -g automatic-rename-format '#{=/15/…:#{?#{==:#{pane_current_command},bash},#{b:pane_current_path},#{?#{==:#{pane_current_command},node},#(ps -o args= --ppid #{pane_pid} | head -1 | cut -d" " -f2 | xargs basename),#{pane_current_command}}}}'

# ----------------------------------------------------------------
# PANE BORDERS
# ----------------------------------------------------------------
# The active pane wears the line colour, amber in a mode, rose while input is synchronised.
set -g pane-border-lines single
set -g pane-border-indicators colour
set -g pane-border-style "fg=$idle"
set -g pane-active-border-style "#{?pane_in_mode,fg=$mode,#{?pane_synchronized,fg=$alert,fg=$line}}"
set -g pane-border-status off
set -g display-panes-colour "$rail"
set -g display-panes-active-colour "$line"

# ----------------------------------------------------------------
# MESSAGES, MENUS AND POPUPS
# ----------------------------------------------------------------
set -g message-style "bg=$plate,fg=$text"
set -g message-command-style "bg=$plate,fg=$mode"
set -g menu-style "fg=$text"
set -g menu-selected-style "bg=$line,fg=$ink,bold"
set -g menu-border-style "fg=$rail"
set -g menu-border-lines rounded
set -g popup-border-style "fg=$line"
set -g popup-border-lines rounded

# ----------------------------------------------------------------
# COPY MODE
# ----------------------------------------------------------------
# Selection and tree-mode highlight are amber; search matches sit on a plate, the current one on the line colour.
setw -g mode-style "bg=$mode,fg=$ink,bold"
setw -g copy-mode-match-style "bg=$plate,fg=$line"
setw -g copy-mode-current-match-style "bg=$line,fg=$ink,bold"
setw -g copy-mode-mark-style "bg=$transfer,fg=$ink"

# ----------------------------------------------------------------
# CLOCK
# ----------------------------------------------------------------
setw -g clock-mode-colour "$line"
setw -g clock-mode-style 12

# ----------------------------------------------------------------
# PLUGIN CONFIGURATION (Commented out but ready to use)
# ----------------------------------------------------------------
# List of plugins
# set -g @plugin 'tmux-plugins/tpm'
# set -g @plugin 'tmux-plugins/tmux-sensible'
# set -g @plugin 'tmux-plugins/tmux-yank'

set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

set -g @resurrect-processes ':all:'
set -g @resurrect-capture-pane-contents 'on'

# Initialize TMUX plugin manager (keep this line at the very bottom)
run '~/.tmux/plugins/tpm/tpm'
