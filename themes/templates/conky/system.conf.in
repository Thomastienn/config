conky.config = {
    -- Position & Size
    alignment = 'top_right',
    gap_x = 28,
    gap_y = 58,
    minimum_width = 240,
    maximum_width = 240,
    -- Shared with calendar.conf so both side panels end on one line.
    minimum_height = 630,
    border_inner_margin = 12,
    border_outer_margin = 0,

    -- Window
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'override',
    own_window_transparent = false,
    own_window_colour = '{{hex.background}}',
    own_window_argb_visual = true,
    own_window_argb_value = 180,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    -- Rendering
    background = false,
    double_buffer = true,
    use_xft = true,
    font = '{{fonts.ui}}:size=9',
    xftalpha = 1,
    lua_load = os.getenv('HOME') .. '/thomas_config/conky/gauges.lua',
    lua_draw_hook_pre = 'backdrop',
    lua_draw_hook_post = 'gauges',

    -- Text
    default_color = 'EEE8DC',
    uppercase = false,
    use_spacer = 'none',
    extra_newline = false,
    text_buffer_size = 8192,

    -- Performance
    update_interval = 1,
    cpu_avg_samples = 4,
    net_avg_samples = 4,
    no_buffers = true,

    -- Disable unused features
    draw_borders = false,
    draw_graph_borders = false,
    draw_outline = false,
    draw_shades = false,
    out_to_console = false,
    out_to_stderr = false,
}

-- gauges.lua draws the whole panel; the text only feeds it sensor readings.
conky.text = [[${texecpi 5 /usr/bin/python3 $HOME/thomas_config/conky/telemetry.py}]]
