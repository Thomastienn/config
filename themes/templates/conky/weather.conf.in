conky.config = {
    alignment = 'bottom_middle',
    -- bottom_middle: negative gap_x shifts right, centering between the unequal side panels.
    gap_x = -45,
    gap_y = 38,
    minimum_width = 440,
    maximum_width = 440,
    minimum_height = 146,
    border_inner_margin = 12,
    border_outer_margin = 0,

    own_window = true,
    own_window_class = 'Conky',
    own_window_title = 'Conky Weather',
    own_window_type = 'override',
    own_window_transparent = false,
    own_window_colour = '{{hex.background}}',
    own_window_argb_visual = true,
    -- Keep muted labels readable over the bright wallpaper.
    own_window_argb_value = 215,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    background = false,
    double_buffer = true,
    use_xft = true,
    font = '{{fonts.ui}}:size=9',
    default_color = '{{hex.text}}',
    lua_load = os.getenv('HOME') .. '/thomas_config/conky/weather.lua',
    lua_draw_hook_post = 'draw_weather',
    -- Check quickly at startup; the first threaded result sets one-minute redraws.
    update_interval = 1,
    text_buffer_size = 4096,
    extra_newline = false,
    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
}

-- Threaded polling keeps a slow network request out of the drawing loop.
conky.text = [[${texecpi 60 python3 $HOME/thomas_config/conky/weather.py}]]
