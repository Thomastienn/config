#version 330
in vec2 texcoord;
uniform sampler2D tex;
uniform float corner_radius;
vec4 default_post_processing(vec4 color);

// Matches "border pixel 2" in the i3 template.
const float WIDTH = 2.0;
const vec3 LINE = vec3({{float.primary}}) / 255.0;
const vec3 TRANSFER = vec3({{float.secondary}}) / 255.0;

vec4 frame(float x, float y) {
    return default_post_processing(texelFetch(tex, ivec2(x, y), 0));
}

bool same(vec4 a, vec4 b) {
    return all(lessThan(abs(a - b), vec4(0.02)));
}

vec4 window_shader() {
    vec2 size = vec2(textureSize(tex, 0));
    vec4 color = default_post_processing(texelFetch(tex, ivec2(texcoord), 0));
    float radius = min(14.0, min(size.x, size.y) / 2.0);
    vec2 edge = min(texcoord, size - texcoord);
    // Tab headers own the top corners; this frame owns the bottom ones.
    if (corner_radius == 0.0) {
        edge.y = size.y - texcoord.y;
    }
    float distance = length(max(vec2(radius) - edge, vec2(0.0))) - radius;
    float band = clamp(distance + WIDTH + 0.5, 0.0, 1.0);
    if (band > 0.0) {
        vec4 left = frame(0.0, size.y / 2.0);
        vec4 right = frame(size.x - 1.0, size.y / 2.0);
        vec4 bottom = frame(size.x / 2.0, size.y - 1.0);
        // Only frames i3 painted: its split indicator recolours the right or the bottom side.
        if (same(left, right) || same(left, bottom)) {
            vec4 border = left;
            if (same(left, vec4(LINE, 1.0) * left.a)) {
                // Focused: the line runs corner to corner into its transfer colour.
                float along = (texcoord.x / size.x + texcoord.y / size.y) * 0.5;
                border.rgb = mix(LINE, TRANSFER, smoothstep(0.15, 0.85, along)) * left.a;
            }
            if (!same(left, right) && size.x - texcoord.x < WIDTH + 0.5) {
                border = right;
            }
            if (!same(left, bottom) && size.y - texcoord.y < WIDTH + 0.5) {
                border = bottom;
            }
            color = mix(color, border, band);
        }
    }
    if (corner_radius == 0.0) {
        color *= clamp(1.0 - distance, 0.0, 1.0);
    }
    return color;
}
