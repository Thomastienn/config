# Cozy Mint notifications: quiet cards, clear titles, compact system controls.
[global]
    monitor = 0
    follow = none

    width = 360
    height = (0, 240)
    origin = top-right
    offset = (24, 58)
    scale = 0
    notification_limit = 3

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 324
    progress_bar_corner_radius = 3

    icon_position = left
    min_icon_size = 32
    max_icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = {{desktop.icons}}, Adwaita
    default_icon = dialog-information
    icon_corner_radius = 0

    font = {{fonts.ui}} 10
    line_height = 3
    markup = full
    format = "<b><span size='large'>%s</span></b>\n<span alpha='85%%'>%b</span>\n<span size='small' alpha='80%%'>%a</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    separator_height = 0
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 14
    frame_width = 1
    gap_size = 12
    separator_color = frame
    sort = yes
    transparency = 0
    corner_radius = 14

    sticky_history = yes
    history_length = 30
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/brave
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current
    idle_threshold = 120

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "{{colors.background}}D9"
    foreground = "{{colors.muted}}"
    frame_color = "{{colors.border}}"
    highlight = "{{colors.primary}}"
    timeout = 4

[urgency_normal]
    background = "{{colors.background}}D9"
    foreground = "{{colors.text}}"
    frame_color = "{{colors.secondary}}"
    highlight = "{{colors.primary}}"
    timeout = 6

[urgency_critical]
    override_pause_level = 60
    background = "{{colors.urgent_background}}E6"
    foreground = "{{colors.text}}"
    frame_color = "{{colors.error}}"
    highlight = "{{colors.error}}"
    timeout = 0

[command-results]
    appname = "Command finished"
    override_pause_level = 60

[manual-volume-controls]
    appname = "volume"
    override_pause_level = 60

[manual-brightness-controls]
    appname = "brightness"
    override_pause_level = 60

[manual-microphone-controls]
    appname = "microphone"
    override_pause_level = 60

# SVG paths cover Papirus status icons missing from its 32px theme lookup.
[volume-up]
    appname = "volume"
    summary = "Volume Up"
    format = "<b>Volume</b>  <span foreground='{{colors.primary}}'>%n%%</span>"
    default_icon = {{icons_root}}/48x48/status/notification-audio-volume-high.svg
    timeout = 2

[volume-down]
    appname = "volume"
    summary = "Volume Down"
    format = "<b>Volume</b>  <span foreground='{{colors.primary}}'>%n%%</span>"
    default_icon = {{icons_root}}/48x48/status/notification-audio-volume-low.svg
    timeout = 2

[volume-unmuted]
    appname = "volume"
    summary = "Unmuted"
    format = "<b>Volume unmuted</b>"
    default_icon = {{icons_root}}/48x48/status/notification-audio-volume-high.svg
    timeout = 2

[volume-muted]
    appname = "volume"
    summary = "Muted"
    format = "<b>Volume muted</b>"
    foreground = "{{colors.muted}}"
    frame_color = "{{colors.border}}"
    default_icon = {{icons_root}}/48x48/status/notification-audio-volume-muted.svg
    timeout = 2

[brightness-up]
    appname = "brightness"
    summary = "Brightness Up"
    format = "<b>Brightness</b>  <span foreground='{{colors.secondary}}'>%n%%</span>"
    default_icon = {{icons_root}}/48x48/status/notification-display-brightness-high.svg
    highlight = "{{colors.secondary}}"
    timeout = 2

[brightness-down]
    appname = "brightness"
    summary = "Brightness Down"
    format = "<b>Brightness</b>  <span foreground='{{colors.secondary}}'>%n%%</span>"
    default_icon = {{icons_root}}/48x48/status/notification-display-brightness-low.svg
    highlight = "{{colors.secondary}}"
    timeout = 2

[mic-unmuted]
    appname = "microphone"
    summary = "*Unmuted*"
    format = "<b>Microphone unmuted</b>"
    default_icon = {{icons_root}}/48x48/status/microphone-sensitivity-high.svg
    timeout = 2

[mic-muted]
    appname = "microphone"
    summary = "*Muted*"
    format = "<b>Microphone muted</b>"
    foreground = "{{colors.muted}}"
    frame_color = "{{colors.border}}"
    default_icon = {{icons_root}}/48x48/status/microphone-sensitivity-muted.svg
    timeout = 2

# App rules supply an icon only when the sender does not provide one.
[taskwarrior]
    appname = "Taskwarrior"
    default_icon = {{icons_root}}/24x24/actions/view-task.svg

[screenshot]
    appname = "*creenshot*"
    summary = "*creenshot*"
    default_icon = {{icons_root}}/symbolic/devices/camera-photo-symbolic.svg
    timeout = 3

[spotify]
    appname = "*potify*"
    default_icon = spotify
    timeout = 4

[battery]
    appname = "*attery*"
    urgency = critical
    background = "{{colors.urgent_background}}E6"
    foreground = "{{colors.text}}"
    frame_color = "{{colors.error}}"
    default_icon = {{icons_root}}/48x48/status/notification-battery-low.svg

[network]
    appname = "*etwork*"
    default_icon = {{icons_root}}/symbolic/devices/network-wireless-symbolic.svg
    timeout = 4

[discord]
    appname = "discord"
    default_icon = discord
    timeout = 5

[discord-dm]
    appname = "discord"
    summary = "Direct Message"
    default_icon = discord
    timeout = 5

[kitty]
    appname = "kitty"
    default_icon = utilities-terminal
    timeout = 5

[brave]
    appname = "Brave*"
    default_icon = brave-browser
    timeout = 5

[brave-download]
    appname = "Brave*"
    summary = "*ownload*"
    default_icon = {{icons_root}}/24x24/actions/document-save.svg
    timeout = 4

[updates]
    appname = "*pdate*"
    summary = "*pdate*"
    default_icon = {{icons_root}}/symbolic/status/software-update-available-symbolic.svg
    timeout = 8

# Eww toggles this last rule; suppressed notifications go straight to history.
[do-not-disturb]
    enabled = false
    skip_display = true
    history_ignore = false
