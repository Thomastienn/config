# Betterlockscreen config

# Display mode: blur, dim, dimblur, pixel, dimpixel, color
display_on=0
span_image=false
lock_timeout=300
fx_list=(dim blur dimblur pixel dimpixel color)
dim_level=40
blur_level=1
pixel_scale=10,1000
solid_color={{hex.background}}
bgcolor={{hex.background}}ff
loginbox=00000000
loginshadow=00000000

# The line: one rule across the screen in the line colour. Keys pulse along it;
# it turns lavender while the password is checked and rose when it is wrong.
font="{{fonts.lock}}"
insidecolor=00000000
ringcolor={{hex.primary}}ff
ringvercolor={{hex.secondary}}ff
ringwrongcolor={{hex.error}}ff
insidevercolor=00000000
insidewrongcolor=00000000
separatorcolor=00000000
timecolor={{hex.text}}ff
greetercolor={{hex.muted}}ff
layoutcolor={{hex.muted}}ff
keyhlcolor={{hex.primary}}ff
bshlcolor={{hex.warning}}ff
verifcolor={{hex.secondary}}ff
wrongcolor={{hex.error}}ff
modifcolor={{hex.warning}}ff

# Station sign above the line, unlock feedback below it
time_format="%H:%M"
date_format="%A, %-d %B"
locktext="Type password to unlock"
veriftext="Checking..."
wrongtext="Try again"

# Override Betterlockscreen's fixed bottom-left layout with i3lock-color options.
# ix:iy is where the sign meets the line; every text hangs off that point.
lockargs=(
    -n
    --ind-pos="x+w*0.09:y+h*0.62"
    --bar-indicator
    --bar-orientation=horizontal
    --bar-direction=2
    --bar-pos="x:y+h*0.62"
    --bar-total-width="w"
    --bar-count=96
    --bar-base-width=2
    --bar-max-height=26
    --bar-step=9
    --bar-periodic-step=3
    --bar-color="$ringcolor"
    --redraw-thread
    --time-pos="ix:iy-84"
    --time-align=1
    --time-font="{{fonts.lock_clock}}"
    --time-size=112
    --date-pos="ix+4:iy-40"
    --date-align=1
    --date-str="$date_format"
    --date-color="$layoutcolor"
    --date-font="$font"
    --date-size=18
    --greeter-pos="ix+4:iy+52"
    --greeter-align=1
    --greeter-size=14
    --verif-pos="ix+4:iy+80"
    --verif-align=1
    --verif-size=14
    --wrong-pos="ix+4:iy+80"
    --wrong-align=1
    --wrong-size=14
    --modif-pos="ix+4:iy+108"
    --modif-align=1
    --layout-pos="ix+4:iy+136"
    --layout-align=1
)

# Wait for the foreground locker, preserving the existing sleep-inhibitor handoff.
tracked_locker() {
    local result locker_pid argument foreground=false
    for argument in "$@"; do
        [[ "$argument" == "-n" || "$argument" == "--nofork" ]] && foreground=true
    done
    if [[ -n ${XSS_SLEEP_LOCK_FD:-} ]]; then
        command "$@" &
        locker_pid=$!
        exec {XSS_SLEEP_LOCK_FD}<&-
        wait "$locker_pid"
        result=$?
    else
        command "$@"
        result=$?
    fi
    if (( result == 0 )) && [[ "$foreground" == true ]]; then
        /usr/bin/python3 "$HOME/thomas_config/scripts/login_log.py" unlock >/dev/null 2>&1 &
    fi
    return "$result"
}
i3lock() { tracked_locker i3lock "$@"; }
i3lock-color() { tracked_locker i3lock-color "$@"; }

# Wallpaper for: betterlockscreen --update "$wallpaper"
wallpaper={{wallpaper_shell}}
