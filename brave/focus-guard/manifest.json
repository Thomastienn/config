{
  "manifest_version": 3,
  "name": "Lock In — Focus Garden",
  "version": "1.0.0",
  "description": "Local, session-only page approvals for Thomas's Focus Garden.",
  "key": "",
  "permissions": ["tabs", "webNavigation", "declarativeNetRequestWithHostAccess", "storage", "nativeMessaging", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Lock In: task access and emergency exit"}
}
